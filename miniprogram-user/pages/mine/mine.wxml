<!-- miniprogram-user/pages/mine/mine.wxml -->
<view class="container">
  <view class="profile-card">
    <image class="avatar" src="{{userInfo.avatarUrl||'/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="profile-info">
      <view class="profile-name">{{userInfo.nickName||'未登录'}}</view>
      <view class="profile-phone">{{userInfo.phone||'绑定手机号'}}</view>
    </view>
    <button class="profile-edit" open-type="getPhoneNumber" bindgetphonenumber="bindPhone">绑定</button>
  </view>

  <view class="card stats-row">
    <view class="stat-item" bindtap="goOrders">
      <view class="stat-num">{{stats.total}}</view>
      <view class="stat-label">全部订单</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.printing}}</view>
      <view class="stat-label">打印中</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.pickup}}</view>
      <view class="stat-label">待取件</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.done}}</view>
      <view class="stat-label">已完成</view>
    </view>
  </view>

  <view class="card menu-list">
    <view class="menu-item" bindtap="goOrders">
      <view class="mi-icon">📋</view>
      <view class="mi-text">我的订单</view>
      <view class="mi-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="aboutPrint">
      <view class="mi-icon">📖</view>
      <view class="mi-text">打印须知</view>
      <view class="mi-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="contactUs">
      <view class="mi-icon">📞</view>
      <view class="mi-text">联系客服</view>
      <view class="mi-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="clearCache">
      <view class="mi-icon">🧹</view>
      <view class="mi-text">清除缓存</view>
      <view class="mi-arrow">›</view>
    </view>
  </view>
</view>
