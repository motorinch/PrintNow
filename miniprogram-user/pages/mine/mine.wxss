/* miniprogram-user/pages/mine/mine.wxss */
.profile-card { background: linear-gradient(135deg, #4A90D9, #357ABD); border-radius: 20rpx; padding: 40rpx 32rpx; display: flex; align-items: center; margin-bottom: 32rpx; color: #fff; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.5); margin-right: 24rpx; }
.profile-info { flex: 1; }
.profile-name { font-size: 34rpx; font-weight: 600; }
.profile-phone { font-size: 24rpx; opacity: 0.8; margin-top: 6rpx; }
.profile-edit { background: rgba(255,255,255,0.2); color: #fff; border: 2rpx solid rgba(255,255,255,0.4); border-radius: 20rpx; padding: 10rpx 24rpx; font-size: 24rpx; line-height: 1.4; }

.stats-row { display: flex; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 36rpx; font-weight: 700; color: var(--primary); }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.menu-list {}
.menu-item { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.menu-item:last-child { border-bottom: none; }
.mi-icon { font-size: 36rpx; margin-right: 20rpx; }
.mi-text { flex: 1; font-size: 28rpx; }
.mi-arrow { font-size: 32rpx; color: #ccc; }
