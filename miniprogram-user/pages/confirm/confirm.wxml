<!-- miniprogram-user/pages/confirm/confirm.wxml -->
<view class="container">
  <view class="card">
    <view class="section-title">📋 订单信息</view>
    <view class="info-row" wx:for="{{files}}" wx:key="name">
      <view class="ir-icon">{{item.icon}}</view>
      <view class="ir-name">{{item.name}}</view>
      <view class="ir-pages">{{item.pages}}页</view>
    </view>
    <view class="divider"></view>
    <view class="info-row">
      <text>份数</text><text>{{config.copies}} 份</text>
    </view>
    <view class="info-row">
      <text>色彩</text><text>{{config.color==='bw'?'黑白':'彩色'}}</text>
    </view>
    <view class="info-row">
      <text>纸张</text><text>{{config.paperSize}} / {{config.duplex==='single'?'单面':'双面'}}</text>
    </view>
    <view class="info-row">
      <text>装订</text><text>{{bindingMap[config.binding]}}</text>
    </view>
    <view class="divider"></view>
    <view class="info-row total-row">
      <text>合计</text><text class="total-price">¥ {{totalPrice}}</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">📍 取件信息</view>
    <view class="form-group">
      <view class="form-label">取件人姓名</view>
      <input class="form-input" placeholder="请输入姓名" value="{{pickupName}}" bindinput="onPickupName" />
    </view>
    <view class="form-group">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" placeholder="请输入手机号" value="{{pickupPhone}}" bindinput="onPickupPhone" />
    </view>
  </view>

  <view class="card">
    <view class="section-title">💬 备注</view>
    <textarea class="form-textarea" placeholder="如有特殊需求请备注（选填）" value="{{remark}}" bindinput="onRemark" maxlength="200" />
  </view>

  <view class="agreement" bindtap="toggleAgree">
    <view class="agree-check {{agreed?'checked':''}}">{{agreed?'✓':''}}</view>
    <text>我已阅读并同意</text><text class="agree-link">《打印服务协议》</text>
  </view>

  <view class="bottom-bar">
    <view class="bb-price">
      <view class="bb-label">应付金额</view>
      <view class="bb-amount">¥ {{totalPrice}}</view>
    </view>
    <button class="btn-primary bb-btn" bindtap="submitOrder" disabled="{{!agreed||submitting}}">
      {{submitting ? '提交中...' : '提交订单并支付'}}
    </button>
  </view>
</view>
