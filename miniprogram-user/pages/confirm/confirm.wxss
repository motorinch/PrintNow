/* miniprogram-user/pages/confirm/confirm.wxss */
.info-row { display: flex; align-items: center; padding: 14rpx 0; font-size: 28rpx; }
.info-row text:first-child { color: #666; flex: 1; }
.info-row text:last-child { font-weight: 500; }
.ir-icon { font-size: 36rpx; margin-right: 12rpx; }
.ir-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ir-pages { color: #999; font-size: 24rpx; margin-left: 12rpx; }
.divider { height: 1rpx; background: var(--border); margin: 16rpx 0; }
.total-row { padding: 18rpx 0; }
.total-price { color: #FF4D4F; font-size: 36rpx; font-weight: 700 !important; }

.form-textarea { width: 100%; height: 140rpx; padding: 20rpx; border: 2rpx solid var(--border); border-radius: var(--radius); font-size: 28rpx; box-sizing: border-box; }

.agreement { display: flex; align-items: center; padding: 24rpx 0; margin-bottom: 24rpx; }
.agree-check { width: 36rpx; height: 36rpx; border: 2rpx solid #ccc; border-radius: 6rpx; margin-right: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; }
.agree-check.checked { background: var(--primary); border-color: var(--primary); }
.agree-link { color: var(--primary); }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 24rpx 40rpx; background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); display: flex; align-items: center; z-index: 100; }
.bb-price { margin-right: 24rpx; }
.bb-label { font-size: 22rpx; color: #999; }
.bb-amount { font-size: 36rpx; color: #FF4D4F; font-weight: 700; }
.bb-btn { flex: 1; }
