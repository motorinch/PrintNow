<!-- miniprogram-user/pages/index/index.wxml -->
<view class="container">
  <view class="hero">
    <view class="hero-icon">🖨️</view>
    <view class="hero-title">PrintNow 云打印</view>
    <view class="hero-desc">上传文件，在线下单，到店取件</view>
  </view>

  <view class="quick-actions">
    <view class="action-card" bindtap="goUpload">
      <view class="action-icon">📄</view>
      <view class="action-text">上传文件</view>
      <view class="action-arrow">›</view>
    </view>
    <view class="action-card" bindtap="goOrders">
      <view class="action-icon">📋</view>
      <view class="action-text">我的订单</view>
      <view class="action-arrow">›</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">📢 打印须知</view>
    <view class="tips">
      <view class="tip-item">支持 PDF、Word、PPT、Excel、图片格式</view>
      <view class="tip-item">黑白 0.2 元/页，彩色 1.0 元/页</view>
      <view class="tip-item">A4/A3 纸张可选，双面打印不加价</view>
      <view class="tip-item">下单后凭取件码到店取件</view>
    </view>
  </view>

  <view class="section" wx:if="{{recentOrders.length}}">
    <view class="section-title">📌 最近订单</view>
    <view class="order-item" wx:for="{{recentOrders}}" wx:key="_id" bindtap="goDetail" data-id="{{item._id}}">
      <view class="oi-left">
        <view class="oi-no">{{item.orderNo}}</view>
        <view class="oi-info">{{item.files.length}}个文件 · {{item.totalPrice}}元</view>
      </view>
      <view class="oi-right">
        <view class="status-tag {{statusMap[item.status].cls}}">{{statusMap[item.status].label}}</view>
      </view>
    </view>
  </view>
</view>
