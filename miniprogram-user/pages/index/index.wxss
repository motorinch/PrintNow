/* miniprogram-user/pages/index/index.wxss */
.hero {
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  border-radius: 20rpx; padding: 60rpx 40rpx; margin-bottom: 32rpx;
  text-align: center; color: #fff;
}
.hero-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; margin-bottom: 12rpx; }
.hero-desc { font-size: 26rpx; opacity: 0.85; }

.quick-actions { display: flex; gap: 24rpx; margin-bottom: 32rpx; }
.action-card {
  flex: 1; background: #fff; border-radius: var(--radius);
  padding: 32rpx 24rpx; display: flex; align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.action-icon { font-size: 48rpx; margin-right: 16rpx; }
.action-text { flex: 1; font-size: 30rpx; font-weight: 500; }
.action-arrow { font-size: 36rpx; color: #ccc; }

.section { margin-bottom: 32rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }

.tips { background: #fff; border-radius: var(--radius); padding: 16rpx 24rpx; }
.tip-item { padding: 12rpx 0; font-size: 26rpx; color: #666; border-bottom: 1rpx solid #f5f5f5; }
.tip-item:last-child { border-bottom: none; }

.order-item {
  background: #fff; border-radius: var(--radius); padding: 24rpx;
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 16rpx;
}
.oi-no { font-size: 28rpx; font-weight: 500; }
.oi-info { font-size: 24rpx; color: #999; margin-top: 6rpx; }
