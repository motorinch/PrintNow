/* miniprogram-user/pages/upload/upload.wxss */
.upload-area {
  background: #fff; border: 3rpx dashed #4A90D9; border-radius: var(--radius);
  padding: 80rpx 0; text-align: center; margin-bottom: 32rpx;
}
.upload-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.upload-text { font-size: 30rpx; color: var(--primary); font-weight: 500; }
.upload-hint { font-size: 24rpx; color: #999; margin-top: 12rpx; }

.file-list { background: #fff; border-radius: var(--radius); padding: 8rpx 0; margin-bottom: 24rpx; }
.file-item { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; border-bottom: 1rpx solid var(--border); }
.file-item:last-child { border-bottom: none; }
.fi-left { display: flex; align-items: center; flex: 1; overflow: hidden; }
.fi-icon { font-size: 44rpx; margin-right: 16rpx; flex-shrink: 0; }
.fi-info { overflow: hidden; }
.fi-name { font-size: 28rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fi-meta { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.fi-del { width: 48rpx; height: 48rpx; border-radius: 50%; background: #FF4D4F; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24rpx; margin-left: 16rpx; }
.add-more { display: flex; align-items: center; justify-content: center; padding: 24rpx; color: var(--primary); font-size: 26rpx; }
.add-icon { font-size: 32rpx; margin-right: 8rpx; font-weight: bold; }

.config-preview {}
.cp-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.cp-row:last-child { border-bottom: none; }
.cp-label { color: #666; font-size: 28rpx; }
.cp-value { font-size: 28rpx; font-weight: 500; }
.cp-highlight { color: var(--primary); }
.cp-edit-hint { text-align: right; color: var(--primary); font-size: 24rpx; margin-top: 12rpx; }

.price-bar { background: #fff; border-radius: var(--radius); padding: 28rpx 24rpx; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.pb-label { font-size: 26rpx; color: #666; }
.pb-detail { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.pb-price { font-size: 40rpx; color: #FF4D4F; font-weight: 700; }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 24rpx; padding-bottom: 40rpx; background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); z-index: 100; }
.bottom-bar .btn-primary { width: 100%; }
