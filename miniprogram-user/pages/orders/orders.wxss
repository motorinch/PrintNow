/* miniprogram-user/pages/orders/orders.wxss */
.tabs { display: flex; background: #fff; border-radius: var(--radius); padding: 8rpx; margin-bottom: 24rpx; overflow-x: auto; }
.tab { flex-shrink: 0; padding: 14rpx 28rpx; font-size: 26rpx; color: #666; border-radius: 8rpx; transition: all 0.2s; }
.tab.active { background: var(--primary); color: #fff; font-weight: 500; }

.order-card {}
.oc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.oc-no { font-size: 26rpx; color: #666; }
.oc-files { margin-bottom: 16rpx; }
.oc-file { font-size: 26rpx; color: #333; padding: 4rpx 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.oc-footer { display: flex; justify-content: space-between; align-items: center; }
.oc-price { font-size: 32rpx; font-weight: 700; color: #FF4D4F; }
.oc-time { font-size: 24rpx; color: #999; }
.oc-pickup { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f5f5f5; font-size: 26rpx; }
.pickup-code { color: var(--primary); font-size: 32rpx; font-weight: 700; letter-spacing: 4rpx; }
.loading { text-align: center; padding: 40rpx; font-size: 24rpx; color: #999; }
