/* miniprogram-user/pages/order-detail/order-detail.wxss */
.status-bar { background: #fff; border-radius: var(--radius); padding: 32rpx 24rpx; margin-bottom: 24rpx; }
.sb-steps { display: flex; align-items: center; justify-content: space-between; }
.step { font-size: 20rpx; color: #ccc; text-align: center; width: 56rpx; }
.step.done { color: var(--success); }
.step.current { color: var(--primary); font-weight: 600; }
.step-line { flex: 1; height: 3rpx; background: #eee; margin: 0 4rpx; }
.step-line.done { background: var(--success); }

.pickup-box { text-align: center; padding: 20rpx 0; }
.pickup-title { font-size: 26rpx; color: #666; }
.pickup-code-big { font-size: 60rpx; font-weight: 700; color: var(--primary); letter-spacing: 8rpx; margin: 16rpx 0; }
.pickup-hint { font-size: 24rpx; color: #999; }

.file-row { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.file-row:last-child { border-bottom: none; }
.fr-icon { font-size: 32rpx; margin-right: 12rpx; }
.fr-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26rpx; }
.fr-pages { font-size: 24rpx; color: #999; margin-left: 12rpx; }

.remark-text { font-size: 26rpx; color: #666; line-height: 1.6; }
