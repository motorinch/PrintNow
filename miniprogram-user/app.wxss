/* miniprogram-user/app.wxss */
page {
  --primary: #4A90D9;
  --primary-dark: #357ABD;
  --success: #52C41A;
  --warning: #FAAD14;
  --danger: #FF4D4F;
  --text: #333333;
  --text-secondary: #999999;
  --bg: #F5F5F5;
  --white: #FFFFFF;
  --border: #E8E8E8;
  --radius: 12rpx;
  box-sizing: border-box;
  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
}

.container { padding: 24rpx; min-height: 100vh; }

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  color: #fff; border-radius: var(--radius); border: none;
  padding: 24rpx 48rpx; font-size: 32rpx; text-align: center;
  display: flex; align-items: center; justify-content: center;
}
.btn-primary:active { opacity: 0.85; }
.btn-outline {
  background: #fff; color: var(--primary); border: 2rpx solid var(--primary);
  border-radius: var(--radius); padding: 24rpx 48rpx; font-size: 32rpx;
  text-align: center; display: flex; align-items: center; justify-content: center;
}

/* 卡片 */
.card {
  background: #fff; border-radius: var(--radius);
  padding: 24rpx; margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 表单 */
.form-group { margin-bottom: 32rpx; }
.form-label { font-size: 28rpx; color: var(--text); margin-bottom: 12rpx; font-weight: 500; }
.form-input {
  width: 100%; padding: 20rpx 24rpx; border: 2rpx solid var(--border);
  border-radius: var(--radius); font-size: 28rpx; box-sizing: border-box;
  background: #fff;
}

/* 状态标签 */
.status-tag {
  display: inline-block; padding: 6rpx 20rpx; border-radius: 20rpx;
  font-size: 24rpx; font-weight: 500;
}
.status-pending   { background: #FFF7E6; color: #FA8C16; }
.status-paid      { background: #E6F7FF; color: #1890FF; }
.status-printing  { background: #F6FFED; color: #52C41A; }
.status-pickup    { background: #FFF0F6; color: #EB2F96; }
.status-done      { background: #F6FFED; color: #52C41A; }
.status-cancelled { background: #FFF1F0; color: #FF4D4F; }

/* 空状态 */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 120rpx 0; color: var(--text-secondary);
}
.empty-state .icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-state .text { font-size: 28rpx; }
