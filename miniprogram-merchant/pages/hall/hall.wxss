/* miniprogram-merchant/pages/hall/hall.wxss */
.header-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.hb-title { font-size: 36rpx; font-weight: 700; }
.hb-count { font-size: 24rpx; color: #999; background: #f0f0f0; padding: 6rpx 16rpx; border-radius: 20rpx; }
.tabs { display: flex; background: #fff; border-radius: var(--radius); padding: 8rpx; margin-bottom: 24rpx; }
.tab { flex: 1; padding: 16rpx; text-align: center; font-size: 26rpx; color: #666; border-radius: 8rpx; }
.tab.active { background: var(--primary); color: #fff; font-weight: 500; }
.order-card {}
.oc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.oc-no { font-size: 26rpx; color: #666; font-weight: 500; }
.oc-body { margin-bottom: 16rpx; }
.oc-files { margin-bottom: 12rpx; }
.oc-file { font-size: 26rpx; padding: 4rpx 0; }
.oc-pages { color: #999; font-size: 22rpx; }
.oc-config { display: flex; flex-wrap: wrap; gap: 8rpx; }
.oc-tag { background: #f0f0f0; padding: 4rpx 14rpx; border-radius: 6rpx; font-size: 22rpx; color: #666; }
.oc-footer { display: flex; justify-content: space-between; align-items: center; }
.oc-price { font-size: 32rpx; font-weight: 700; color: var(--danger); }
.oc-time { font-size: 24rpx; color: #999; }
.oc-actions { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border); }
.btn-sm { padding: 16rpx 32rpx; font-size: 26rpx; }
.loading { text-align: center; padding: 40rpx; font-size: 24rpx; color: #999; }
